// void addRange(set S, int from, int to)
Obj addRange = Tab.insert(Obj.Meth, "addRange", Tab.noType);
Tab.openScope();
Tab.insert(Obj.Var, "S", setType);
Tab.insert(Obj.Var, "from", Tab.intType);
Tab.insert(Obj.Var, "to", Tab.intType);
addRange.setLevel(1);
Tab.closeScope();
addRange.setAdr(Code.pc);   // odmah posle ovoga ide emit tela

emitAddRangeBody();         // (vidi dole)





