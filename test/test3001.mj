private static void generateSortSet() {
    Obj sortSet = Tab.find("sortSet");
    sortSet.setAdr(Code.pc);

    // formals=1: s(0); locals: i(1), j(2), t(3)  => total=4
    Code.put(Code.enter);
    Code.put(1);
    Code.put(4);

    // i = 1
    Code.loadConst(1);
    Code.put(Code.store_n + 1);

    int L_outer = Code.pc;
    // if (i >= s[0]) END
    Code.put(Code.load_n + 1);          // i
    Code.put(Code.load_n);              // s
    Code.loadConst(0);
    Code.put(Code.aload);               // n = s[0]
    Code.putFalseJump(Code.lt, 0);      // i < n ?
    int J_end = Code.pc - 2;

    // j = 1
    Code.loadConst(1);
    Code.put(Code.store_n + 2);

    int L_inner = Code.pc;
    // if (j >= n - i + 1) INC_I   (ekvivalentno: j < n - i + 1)
    Code.put(Code.load_n + 2);          // j
    Code.put(Code.load_n);              // s
    Code.loadConst(0);
    Code.put(Code.aload);               // n
    Code.put(Code.load_n + 1);          // i
    Code.put(Code.sub);                 // n - i
    Code.putFalseJump(Code.lt, 0);      // j < (n - i) ?
    int J_inc_i = Code.pc - 2;

    // if (s[j] > s[j+1]) swap
    // s[j]
    Code.put(Code.load_n);              // s
    Code.put(Code.load_n + 2);          // j
    Code.put(Code.aload);               // s[j]

    // s[j+1]
    Code.put(Code.load_n);              // s
    Code.put(Code.load_n + 2);          // j
    Code.loadConst(1);
    Code.put(Code.add);                 // j+1
    Code.put(Code.aload);               // s[j+1]

    Code.putFalseJump(Code.gt, 0);      // if !(s[j] > s[j+1]) skip
    int J_skip = Code.pc - 2;

    // t = s[j]
    Code.put(Code.load_n);              // s
    Code.put(Code.load_n + 2);          // j
    Code.put(Code.aload);
    Code.put(Code.store_n + 3);         // t

    // s[j] = s[j+1]
    Code.put(Code.load_n);              // s
    Code.put(Code.load_n + 2);          // j
    Code.put(Code.load_n);              // s
    Code.put(Code.load_n + 2);          // j
    Code.loadConst(1); Code.put(Code.add);
    Code.put(Code.aload);               // s[j+1]
    Code.put(Code.astore);

    // s[j+1] = t
    Code.put(Code.load_n);              // s
    Code.put(Code.load_n + 2);          // j
    Code.loadConst(1); Code.put(Code.add);
    Code.put(Code.load_n + 3);          // t
    Code.put(Code.astore);

    // skip:
    Code.fixup(J_skip);

    // j++
    Code.put(Code.load_n + 2);
    Code.loadConst(1);
    Code.put(Code.add);
    Code.put(Code.store_n + 2);
    Code.putJump(L_inner);

    // INC_I:
    Code.fixup(J_inc_i);
    Code.put(Code.load_n + 1);
    Code.loadConst(1);
    Code.put(Code.add);
    Code.put(Code.store_n + 1);
    Code.putJump(L_outer);

    // END:
    Code.fixup(J_end);
    Code.put(Code.exit);
    Code.put(Code.return_);
}





Obj swapBetween = Tab.insert(Obj.Meth, "swapBetween", Tab.noType);
Tab.openScope();
Tab.insert(Obj.Var, "A", Tab.find("set").getType());
Tab.insert(Obj.Var, "i", Tab.intType);
Tab.insert(Obj.Var, "B", Tab.find("set").getType());
Tab.insert(Obj.Var, "j", Tab.intType);
swapBetween.setLevel(1);
Tab.closeScope();


private static void generateSwapBetween() {
    Obj swapBetween = Tab.find("swapBetween");
    swapBetween.setAdr(Code.pc);

    // formals=4: A(0), i(1), B(2), j(3); locals: t(4) => total=5
    Code.put(Code.enter);
    Code.put(4);
    Code.put(5);

    // provere: 1 <= i <= A[0], 1 <= j <= B[0]  (trap(2) na fail)
    // i >= 1 ?
    Code.put(Code.load_n + 1); Code.loadConst(1);
    int okIge1 = Code.pc + 1; Code.putFalseJump(Code.ge, 0);
    Code.put(Code.trap); Code.put(2); Code.fixup(okIge1);
    // i <= A[0] ?
    Code.put(Code.load_n + 1);
    Code.put(Code.load_n); Code.loadConst(0); Code.put(Code.aload);
    int okIle = Code.pc + 1; Code.putFalseJump(Code.le, 0);
    Code.put(Code.trap); Code.put(2); Code.fixup(okIle);

    // j >= 1 ?
    Code.put(Code.load_n + 3); Code.loadConst(1);
    int okJge1 = Code.pc + 1; Code.putFalseJump(Code.ge, 0);
    Code.put(Code.trap); Code.put(2); Code.fixup(okJge1);
    // j <= B[0] ?
    Code.put(Code.load_n + 3);
    Code.put(Code.load_n + 2); Code.loadConst(0); Code.put(Code.aload);
    int okJle = Code.pc + 1; Code.putFalseJump(Code.le, 0);
    Code.put(Code.trap); Code.put(2); Code.fixup(okJle);

    // t = A[i]
    Code.put(Code.load_n);      // A
    Code.put(Code.load_n + 1);  // i
    Code.put(Code.aload);
    Code.put(Code.store_n + 4); // t

    // A[i] = B[j]
    Code.put(Code.load_n);      // A
    Code.put(Code.load_n + 1);  // i
    Code.put(Code.load_n + 2);  // B
    Code.put(Code.load_n + 3);  // j
    Code.put(Code.aload);       // B[j]
    Code.put(Code.astore);

    // B[j] = t
    Code.put(Code.load_n + 2);  // B
    Code.put(Code.load_n + 3);  // j
    Code.put(Code.load_n + 4);  // t
    Code.put(Code.astore);

    Code.put(Code.exit);
    Code.put(Code.return_);
}


