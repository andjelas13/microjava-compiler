    if (argumentTypes.size()!=4 ||
        argumentTypes.get(0)!=setType ||
        argumentTypes.get(1)!=Tab.intType ||
        argumentTypes.get(2)!=setType ||
        argumentTypes.get(3)!=Tab.intType)
        report_error("swapBetween(a,i,b,j): (set,int,set,int)", methodCall);
    break;



private static void generateSortSet() {
    Obj sortSet = Tab.find("sortSet");
    sortSet.setAdr(Code.pc);

    // formals = 1 (s), locals = 3 (i, j, t)  => ukupno slotova 4
    Code.put(Code.enter);
    Code.put(1);
    Code.put(4);

    // i = 1;
    Code.loadConst(1);
    Code.put(Code.store_n + 1);

    int L_outer = Code.pc;
    // if (i >= s[0]) goto END;   (tj. i <= s[0]-1 ?)
    Code.put(Code.load_n + 1);   // i
    Code.put(Code.load_n);       // i, s
    Code.loadConst(0);           // i, s, 0
    Code.put(Code.aload);        // i, size
    Code.loadConst(1);
    Code.put(Code.sub);          // i, size-1
    Code.putFalseJump(Code.lt, 0);
    int J_end = Code.pc - 2;

    // j = 1;
    Code.loadConst(1);
    Code.put(Code.store_n + 2);

    int L_inner = Code.pc;
    // if (j > s[0]-i) goto INC_I;
    Code.put(Code.load_n + 2);   // j
    Code.put(Code.load_n);       // j, s
    Code.loadConst(0);
    Code.put(Code.aload);        // j, size
    Code.put(Code.load_n + 1);   // j, size, i
    Code.put(Code.sub);          // j, size - i
    Code.putFalseJump(Code.le, 0);
    int J_inc_i = Code.pc - 2;

    // if (s[j] > s[j+1]) swap
    // a = s[j]
    Code.put(Code.load_n);       // s
    Code.put(Code.load_n + 2);   // s, j
    Code.put(Code.aload);        // s[j]

    // b = s[j+1]
    Code.put(Code.load_n);       // s
    Code.put(Code.load_n + 2);   // s, j
    Code.loadConst(1);
    Code.put(Code.add);          // s, j+1
    Code.put(Code.aload);        // s[j+1]

    // if (!(a > b)) skip
    Code.putFalseJump(Code.gt, 0);
    int J_skip = Code.pc - 2;

    // t = s[j]
    Code.put(Code.load_n);       // s
    Code.put(Code.load_n + 2);   // s, j
    Code.put(Code.aload);        // s[j]
    Code.put(Code.store_n + 3);  // t

    // s[j] = s[j+1]
    Code.put(Code.load_n);       // s
    Code.put(Code.load_n + 2);   // s, j
    Code.put(Code.load_n);       // s, j, s
    Code.put(Code.load_n + 2);   // s, j, s, j
    Code.loadConst(1);
    Code.put(Code.add);          // s, j, s, j+1
    Code.put(Code.aload);        // s, j, s[j+1]
    Code.put(Code.astore);

    // s[j+1] = t
    Code.put(Code.load_n);       // s
    Code.put(Code.load_n + 2);   // s, j
    Code.loadConst(1);
    Code.put(Code.add);          // s, j+1
    Code.put(Code.load_n + 3);   // s, j+1, t
    Code.put(Code.astore);

    // skip
    Code.fixup(J_skip);

    // j++
    Code.put(Code.load_n + 2);
    Code.loadConst(1);
    Code.put(Code.add);
    Code.put(Code.store_n + 2);
    Code.putJump(L_inner);

    // INC_I:
    Code.fixup(J_inc_i);
    Code.put(Code.load_n + 1);
    Code.loadConst(1);
    Code.put(Code.add);
    Code.put(Code.store_n + 1);
    Code.putJump(L_outer);

    // END:
    Code.fixup(J_end);
    Code.put(Code.exit);
    Code.put(Code.return_);
}




private static void generateSwapBetween() {
    Obj swapBetween = Tab.find("swapBetween");
    swapBetween.setAdr(Code.pc);

    Code.put(Code.enter);
    Code.put(4); // a(0), i(1), b(2), j(3)
    Code.put(5); // + t(4)

    // Validacije: 1 <= i <= a[0], 1 <= j <= b[0]
    // i >= 1 ?
    Code.put(Code.load_n + 1); Code.loadConst(1);
    int okIge1 = Code.pc + 1; Code.putFalseJump(Code.ge, 0);
    Code.put(Code.trap); Code.put(2); Code.fixup(okIge1);

    // i <= a[0] ?
    Code.put(Code.load_n + 1);
    Code.put(Code.load_n); Code.loadConst(0); Code.put(Code.aload);
    int okIle = Code.pc + 1; Code.putFalseJump(Code.le, 0);
    Code.put(Code.trap); Code.put(2); Code.fixup(okIle);

    // j >= 1 ?
    Code.put(Code.load_n + 3); Code.loadConst(1);
    int okJge1 = Code.pc + 1; Code.putFalseJump(Code.ge, 0);
    Code.put(Code.trap); Code.put(2); Code.fixup(okJge1);

    // j <= b[0] ?
    Code.put(Code.load_n + 3);
    Code.put(Code.load_n + 2); Code.loadConst(0); Code.put(Code.aload);
    int okJle = Code.pc + 1; Code.putFalseJump(Code.le, 0);
    Code.put(Code.trap); Code.put(2); Code.fixup(okJle);

    // t = a[i]
    Code.put(Code.load_n);      // a
    Code.put(Code.load_n + 1);  // i
    Code.put(Code.aload);
    Code.put(Code.store_n + 4); // t

    // a[i] = b[j]
    Code.put(Code.load_n);      // a
    Code.put(Code.load_n + 1);  // i
    Code.put(Code.load_n + 2);  // b
    Code.put(Code.load_n + 3);  // j
    Code.put(Code.aload);       // b[j]
    Code.put(Code.astore);      // a[i] = b[j]

    // b[j] = t
    Code.put(Code.load_n + 2);  // b
    Code.put(Code.load_n + 3);  // j
    Code.put(Code.load_n + 4);  // t
    Code.put(Code.astore);

    Code.put(Code.exit);
    Code.put(Code.return_);
}


// pretpostavka: A, B, C su tipa set; x, y, z su int

sortSet(A);                     // in-place sort A
swapAcross(A, 2, B, 5);         // A[2] <-> B[5]

x = subset(A, B);               // 1 ako je A⊆B
y = equalsSet(A, B);            // 1 ako su jednaki
z = disjoint(A, B);             // 1 ako su disjunktni

symdiff(C, A, B);               // C = A △ B
x = countEven(A);               // broj parnih u A
y = countOdd(B);                // broj neparnih u B








