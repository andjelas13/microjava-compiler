private static void generateSubset() {
    Obj f = Tab.find("subset");
    Obj contains = Tab.find("contains");
    f.setAdr(Code.pc);

    Code.put(Code.enter); Code.put(2); Code.put(3); // a,b ; i

    // i = 1
    Code.loadConst(1); Code.put(Code.store_n + 2);
    int loop = Code.pc;
    // if (i > a[0]) return 1;
    Code.put(Code.load_n + 2); Code.put(Code.load_n); Code.loadConst(0); Code.put(Code.aload);
    Code.putFalseJump(Code.le, 0); int jRet1 = Code.pc - 2;
    // elem = a[i]; if (!contains(b, elem)) return 0;
    Code.put(Code.load_n + 1);              // b
    Code.put(Code.load_n); Code.put(Code.load_n + 2); Code.put(Code.aload); // elem
    Code.put(Code.call); Code.put2(contains.getAdr() - Code.pc + 1);
    Code.loadConst(0); Code.putFalseJump(Code.ne, 0); int jCont = Code.pc - 2; // ako ==0 -> nije podskup
    Code.loadConst(0); Code.put(Code.exit); Code.put(Code.return_); // return 0

    Code.fixup(jCont);
    // i++
    Code.put(Code.load_n + 2); Code.loadConst(1); Code.put(Code.add); Code.put(Code.store_n + 2);
    Code.putJump(loop);

    Code.fixup(jRet1);
    Code.loadConst(1); Code.put(Code.exit); Code.put(Code.return_);
}


private static void generateEqualsSet() {
    Obj f = Tab.find("equalsSet");
    Obj subset = Tab.find("subset");
    f.setAdr(Code.pc);

    Code.put(Code.enter); Code.put(2); Code.put(2); // a,b

    // if (a[0] != b[0]) return 0;
    Code.put(Code.load_n); Code.loadConst(0); Code.put(Code.aload);
    Code.put(Code.load_n + 1); Code.loadConst(0); Code.put(Code.aload);
    Code.putFalseJump(Code.eq, 0); int jNotEq = Code.pc - 2;
    // return 0
    Code.loadConst(0); Code.put(Code.exit); Code.put(Code.return_);

    // sizes equal -> return subset(a,b)
    Code.fixup(jNotEq);
    Code.put(Code.load_n); Code.put(Code.load_n + 1);
    Code.put(Code.call); Code.put2(subset.getAdr() - Code.pc + 1);
    Code.put(Code.exit); Code.put(Code.return_);
}





private static void generateDisjoint() {
    Obj f = Tab.find("disjoint");
    Obj contains = Tab.find("contains");
    f.setAdr(Code.pc);

    Code.put(Code.enter); Code.put(2); Code.put(3); // a,b ; i
    Code.loadConst(1); Code.put(Code.store_n + 2); // i=1
    int L = Code.pc;

    // if (i > a[0]) return 1;
    Code.put(Code.load_n + 2); Code.put(Code.load_n); Code.loadConst(0); Code.put(Code.aload);
    Code.putFalseJump(Code.le, 0); int J_ret1 = Code.pc - 2;

    // if (contains(b, a[i]) != 0) return 0;
    Code.put(Code.load_n + 1);
    Code.put(Code.load_n); Code.put(Code.load_n + 2); Code.put(Code.aload);
    Code.put(Code.call); Code.put2(contains.getAdr() - Code.pc + 1);
    Code.loadConst(0); Code.putFalseJump(Code.eq, 0); int J_cont = Code.pc - 2;
    Code.loadConst(0); Code.put(Code.exit); Code.put(Code.return_);

    Code.fixup(J_cont);
    Code.put(Code.load_n + 2); Code.loadConst(1); Code.put(Code.add); Code.put(Code.store_n + 2);
    Code.putJump(L);

    Code.fixup(J_ret1);
    Code.loadConst(1); Code.put(Code.exit); Code.put(Code.return_);
}







private static void generateCountEven() {
    Obj f = Tab.find("countEven");
    f.setAdr(Code.pc);

    Code.put(Code.enter); Code.put(1); Code.put(3); // s ; i,cnt
    Code.loadConst(0); Code.put(Code.store_n + 2); // cnt = 0
    Code.loadConst(1); Code.put(Code.store_n + 1); // i = 1
    int L = Code.pc;

    Code.put(Code.load_n + 1); Code.put(Code.load_n); Code.loadConst(0); Code.put(Code.aload);
    Code.putFalseJump(Code.le, 0); int Jend = Code.pc - 2;

    // if (s[i] % 2 == 0) cnt++
    Code.put(Code.load_n); Code.put(Code.load_n + 1); Code.put(Code.aload);
    Code.loadConst(2); Code.put(Code.rem);
    Code.loadConst(0); Code.putFalseJump(Code.eq, 0); int Jskip = Code.pc - 2;
    Code.put(Code.load_n + 2); Code.loadConst(1); Code.put(Code.add); Code.put(Code.store_n + 2);
    Code.fixup(Jskip);

    // i++
    Code.put(Code.load_n + 1); Code.loadConst(1); Code.put(Code.add); Code.put(Code.store_n + 1);
    Code.putJump(L);

    Code.fixup(Jend);
    Code.put(Code.load_n + 2); Code.put(Code.exit); Code.put(Code.return_);
}

private static void generateCountOdd() {
    Obj f = Tab.find("countOdd");
    f.setAdr(Code.pc);

    Code.put(Code.enter); Code.put(1); Code.put(3); // s ; i,cnt
    Code.loadConst(0); Code.put(Code.store_n + 2); // cnt = 0
    Code.loadConst(1); Code.put(Code.store_n + 1); // i = 1
    int L = Code.pc;

    Code.put(Code.load_n + 1); Code.put(Code.load_n); Code.loadConst(0); Code.put(Code.aload);
    Code.putFalseJump(Code.le, 0); int Jend = Code.pc - 2;

    // if (s[i] % 2 != 0) cnt++
    Code.put(Code.load_n); Code.put(Code.load_n + 1); Code.put(Code.aload);
    Code.loadConst(2); Code.put(Code.rem);
    Code.loadConst(0); Code.putFalseJump(Code.ne, 0); int Jskip = Code.pc - 2;
    Code.put(Code.load_n + 2); Code.loadConst(1); Code.put(Code.add); Code.put(Code.store_n + 2);
    Code.fixup(Jskip);

    Code.put(Code.load_n + 1); Code.loadConst(1); Code.put(Code.add); Code.put(Code.store_n + 1);
    Code.putJump(L);

    Code.fixup(Jend);
    Code.put(Code.load_n + 2); Code.put(Code.exit); Code.put(Code.return_);
}






private static void generateSymDiff() {
    Obj symDiff = Tab.find("symDiff");
    symDiff.setAdr(Code.pc);

    // formals: out(0), a(1), b(2)
    // locals frame: out,a,b + t1(3), t2(4)
    Code.put(Code.enter);
    Code.put(3);  // #formals
    Code.put(5);  // ukupno slotova (formali + lokali)

    // --- t1 = new int[len(a)] ; t1[0]=0
    Code.put(Code.load_n + 1);     // a
    Code.put(Code.arraylength);    // len(a)
    Code.put(Code.newarray); Code.put(1); // int[]
    Code.put(Code.store_n + 3);    // t1
    Code.put(Code.load_n + 3); Code.loadConst(0); Code.loadConst(0); Code.put(Code.astore);

    // --- t2 = new int[len(b)] ; t2[0]=0
    Code.put(Code.load_n + 2);     // b
    Code.put(Code.arraylength);
    Code.put(Code.newarray); Code.put(1);
    Code.put(Code.store_n + 4);    // t2
    Code.put(Code.load_n + 4); Code.loadConst(0); Code.loadConst(0); Code.put(Code.astore);

    // addresses (pretpostavka: imaš callable metode; vidi B) ako nema)
    Obj difference = Tab.find("difference");
    Obj union      = Tab.find("union");
    Obj addAll     = Tab.find("addAll");

    // t1 = difference(a, b)  -> difference(t1, a, b)
    Code.put(Code.load_n + 3); // t1
    Code.put(Code.load_n + 1); // a
    Code.put(Code.load_n + 2); // b
    Code.put(Code.call); Code.put2(difference.getAdr() - Code.pc + 1);

    // t2 = difference(b, a)  -> difference(t2, b, a)
    Code.put(Code.load_n + 4); // t2
    Code.put(Code.load_n + 2); // b
    Code.put(Code.load_n + 1); // a
    Code.put(Code.call); Code.put2(difference.getAdr() - Code.pc + 1);

    // out = union(t1, t2)    -> out[0]=0 ; addAll(out, t1); addAll(out, t2)  (ili pozovi union ako ga imaš)
    // out[0]=0
    Code.put(Code.load_n); Code.loadConst(0); Code.loadConst(0); Code.put(Code.astore);

    // addAll(out, t1)
    Code.put(Code.load_n);     // out
    Code.put(Code.load_n + 3); // t1
    Code.put(Code.call); Code.put2(addAll.getAdr() - Code.pc + 1);

    // addAll(out, t2)
    Code.put(Code.load_n);     // out
    Code.put(Code.load_n + 4); // t2
    Code.put(Code.call); Code.put2(addAll.getAdr() - Code.pc + 1);

    Code.put(Code.exit);
    Code.put(Code.return_);
}





if (n.getSetop() instanceof SetopSymdiff) {
    Obj add      = Tab.find("add");
    Obj contains = Tab.find("contains");

    // target = Ø
    Code.load(target);
    Code.loadConst(0);
    Code.loadConst(0);
    Code.put(Code.astore);

    // Δ = (left \ right) ∪ (right \ left)
    genDiffElems(target, left,  right, add, contains);  // left minus right -> target
    genDiffElems(target, right, left,  add, contains);  // right minus left -> target
    return;
}





private void genDiffElems(Obj target, Obj left, Obj right, Obj add, Obj contains) {
    // i = 1
    Code.loadConst(1);                // [ i ]
    int L_loop = Code.pc;

    // if (!(i <= left[0])) break;
    Code.put(Code.dup);               // i, i
    Code.load(left);                  // i, i, left
    Code.loadConst(0);                // i, i, left, 0
    Code.put(Code.aload);             // i, i, sizeL
    Code.putFalseJump(Code.le, 0);    // skok kada i > sizeL
    int L_end = Code.pc - 2;          // [ i ]

    // elem = left[i]    (sačuvaj i na steku)
    Code.put(Code.dup);               // i, i
    Code.load(left);                  // i, i, left
    Code.put(Code.dup_x1); Code.put(Code.pop); // i, left, i
    Code.put(Code.aload);             // i, elem

    // res = contains(right, elem)
    Code.load(right);                 // i, elem, right
    Code.put(Code.dup_x1); Code.put(Code.pop); // i, right, elem
    Code.put(Code.call);
    Code.put2(contains.getAdr() - Code.pc + 1); // i, res

    // if (res != 0) skip add
    Code.loadConst(0);                // i, res, 0
    Code.putFalseJump(Code.eq, 0);    // skok ako res != 0
    int L_skip = Code.pc - 2;         // [ i ]

    // add(target, left[i])  (ponovo dohvati elem)
    Code.put(Code.dup);               // i, i
    Code.load(left);                  // i, i, left
    Code.put(Code.dup_x1); Code.put(Code.pop); // i, left, i
    Code.put(Code.aload);             // i, elem
    Code.load(target);                // i, elem, target
    Code.put(Code.dup_x1); Code.put(Code.pop); // i, target, elem
    Code.put(Code.call);
    Code.put2(add.getAdr() - Code.pc + 1);     // [ i ]

    // skip:
    Code.fixup(L_skip);

    // i++
    Code.loadConst(1);
    Code.put(Code.add);               // i+1
    Code.putJump(L_loop);

    // kraj
    Code.fixup(L_end);
    Code.put(Code.pop);               // skini i
}







private static void generateDisjoint() {
    Obj disj      = Tab.find("disjoint");
    Obj contains  = Tab.find("contains");  // int contains(set,int)

    disj.setAdr(Code.pc);

    // formals = 2 (A,B), locals = 3 (A,B,i)
    Code.put(Code.enter);
    Code.put(2);
    Code.put(3);

    // i = 1
    Code.loadConst(1);
    Code.put(Code.store_n + 2); // i

    int L_loop = Code.pc;

    // if (i > A[0]) return 1;
    Code.put(Code.load_n + 2);  // i
    Code.put(Code.load_n);      // A
    Code.loadConst(0);
    Code.put(Code.aload);       // sizeA
    Code.putFalseJump(Code.le, 0);
    int J_ret1 = Code.pc - 2;   // skok kad i > sizeA
    // (nakon fixup-a ide return 1)

    // elem = A[i]
    Code.put(Code.load_n);      // A
    Code.put(Code.load_n + 2);  // i
    Code.put(Code.aload);       // elem

    // if (contains(B, elem) != 0) return 0;
    Code.put(Code.load_n + 1);  // B
    Code.put(Code.dup_x1); Code.put(Code.pop);  // B, elem (red: set,int)
    Code.put(Code.call);
    Code.put2(contains.getAdr() - Code.pc + 1);
    Code.loadConst(0);
    Code.putFalseJump(Code.ne, 0);
    int J_ret0 = Code.pc - 2;   // skok kad je != 0 (naći će se element)

    // i++
    Code.put(Code.load_n + 2);
    Code.loadConst(1);
    Code.put(Code.add);
    Code.put(Code.store_n + 2);
    Code.putJump(L_loop);

    // -> return 1 (disjunktni)
    Code.fixup(J_ret1);
    Code.loadConst(1);
    Code.put(Code.exit);
    Code.put(Code.return_);

    // -> return 0 (nisu disjunktni)
    Code.fixup(J_ret0);
    Code.loadConst(0);
    Code.put(Code.exit);
    Code.put(Code.return_);
}














Factor ::=
    /* ... postojeće ... */
  | (SupersetOp) DesignatorName SUPERSET DesignatorName
  ;


public void visit(SupersetOp n) {
    Obj A = n.getDesignatorName().obj;      // levo: A
    Obj B = n.getDesignatorName1().obj;     // desno: B
    Obj contains = Tab.find("contains");    // int contains(set,int)

    // i = 1 (držimo i na steku tokom petlje)
    Code.loadConst(1);                         // [ i ]

    int L_loop = Code.pc;

    // if (i <= B[0]) continue else goto TRUE_END
    Code.put(Code.dup);                        // [ i, i ]
    Code.load(B);                              // [ i, i, B ]
    Code.loadConst(0);                         // [ i, i, B, 0 ]
    Code.put(Code.aload);                      // [ i, i, sizeB ]
    Code.putFalseJump(Code.le, 0);             // skok kad i > sizeB
    int J_trueEnd = Code.pc - 2;               // fix kasnije; stack: [ i ]

    // elem = B[i]   (ne troši i)
    Code.put(Code.dup);                        // [ i, i ]
    Code.load(B);                              // [ i, i, B ]
    Code.put(Code.dup_x1); Code.put(Code.pop);// [ i, B, i ]
    Code.put(Code.aload);                      // [ i, elem ]

    // res = contains(A, elem)
    Code.load(A);                              // [ i, elem, A ]
    Code.put(Code.dup_x1); Code.put(Code.pop);// [ i, A, elem ]
    Code.put(Code.call);
    Code.put2(contains.getAdr() - Code.pc + 1);// [ i, res ]

    // if (res == 0) -> return 0
    Code.loadConst(0);                         // [ i, res, 0 ]
    Code.putFalseJump(Code.ne, 0);             // skok ako res != 0 (tj. elem je u A)
    int J_false = Code.pc - 2;                 // fix kasnije; stack: [ i ]
    // ovde je res == 0: nije superset -> vrednost false
    Code.put(Code.pop);                        // skini i
    Code.loadConst(0);                         // [ 0 ]
    return; // kao izraz – ostaje 0 na steku

    // continue: i++
    Code.fixup(J_false);
    Code.loadConst(1);                         // [ i, 1 ]
    Code.put(Code.add);                        // [ i+1 ]
    Code.putJump(L_loop);

    // kraj: superset je tačan -> vrati 1
    Code.fixup(J_trueEnd);
    Code.put(Code.pop);                        // skini i
    Code.loadConst(1);                         // [ 1 ]
}











